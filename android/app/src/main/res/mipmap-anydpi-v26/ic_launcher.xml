<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher fills its whole shape with the dark background, so no white plate.
     Layers are drawn by tools/make_launcher_icon.py. Older Android uses the plain mipmap PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
