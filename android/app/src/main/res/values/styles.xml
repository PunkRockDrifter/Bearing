<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 7 to 9: the light Contour paper, with dark status bar icons -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="ground">#E8EBE3</color>
</resources>
